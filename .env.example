# All settings have working defaults — this file is optional.
# Copy to .env and uncomment what you need.

# Session/CSRF signing key. If unset, one is generated on first run and
# persisted in the data volume (data/.secret_key).
#SECRET_KEY=

# Never run DEBUG=True on a network you don't fully trust.
#DEBUG=False

# Comma-separated. Default: * (this is a LAN tool; restrict if exposed wider).
#ALLOWED_HOSTS=*

# Needed when serving behind a reverse proxy with TLS,
# e.g. https://atem.example.com
#CSRF_TRUSTED_ORIGINS=

# WebSockets are same-origin only, regardless of ALLOWED_HOSTS. Set this
# only if a reverse proxy rewrites the Host header on the way to the app —
# list the browser-facing host(s), e.g. atem.example.com or atem.example.com:8443
#WEBSOCKET_ALLOWED_ORIGINS=

# Operator-facing timestamps (capture filenames etc.)
# Branding in the navbar / browser title
#APP_TITLE=WebATEM

#TIME_ZONE=UTC
#TIME_FORMAT_24HR=True
